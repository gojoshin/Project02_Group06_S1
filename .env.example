# Active Profile: 'default' (H2 in-memory) or 'render' (Render PostgreSQL)
SPRING_PROFILES_ACTIVE=default

# TMDB API Key
TMDB_API_KEY=your_tmdb_api_key_here

# Render Connection Settings
RENDER_DB_HOST=dpg-xxxxxxxx.oregon-postgres.render.com
RENDER_DB_NAME=moviebox_db
RENDER_DB_USER=moviebox_user
RENDER_DB_PASSWORD=your_render_database_password
